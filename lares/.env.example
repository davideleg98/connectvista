# Lares backend configuration
DATABASE_URL=postgresql+psycopg://lares:lares@localhost:5432/lares

# Optional credentials — the system runs without them; adapters that need
# them raise MissingCredentialError instead of failing silently. See
# lares/SOURCES.md "Missing credentials".
ENTSOE_API_TOKEN=
GOOGLE_MAPS_API_KEY=
OPENCORPORATES_API_TOKEN=

# CORS origin for the web app during local dev
LARES_WEB_ORIGIN=http://localhost:5183
